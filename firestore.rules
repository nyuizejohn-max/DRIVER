rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['owner', 'admin'];
    }

    function isApprovedDriver(driverId) {
      return signedIn()
        && request.auth.uid == driverId
        && exists(/databases/$(database)/documents/drivers/$(driverId))
        && get(/databases/$(database)/documents/drivers/$(driverId)).data.approved == true
        && get(/databases/$(database)/documents/drivers/$(driverId)).data.status == 'approved';
    }

    function validSchedule() {
      return request.resource.data.scheduleConfigured == true
        && request.resource.data.workingDays is list
        && request.resource.data.workingDays.size() >= 1
        && request.resource.data.workingDays.size() <= 7
        && request.resource.data.workingDays.hasOnly([
          'Monday', 'Tuesday', 'Wednesday', 'Thursday',
          'Friday', 'Saturday', 'Sunday'
        ])
        && request.resource.data.dutyStartTime is string
        && request.resource.data.dutyStartTime.matches(
          '^([01][0-9]|2[0-3]):[0-5][0-9]$'
        )
        && request.resource.data.dutyEndTime is string
        && request.resource.data.dutyEndTime.matches(
          '^([01][0-9]|2[0-3]):[0-5][0-9]$'
        )
        && request.resource.data.scheduleUpdatedAt == request.time;
    }

    // ADMIN ACCOUNTS
    // Admin accounts must be created through a trusted process,
    // not by a driver using the app.
    match /users/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || isAdmin());

      allow create, delete: if false;

      // Admins can approve or reject driver-related admin accounts
      // only through a trusted process; client-side admin profile
      // changes are deliberately disabled here.
      allow update: if false;
    }

    // DRIVER PROFILES
    match /drivers/{driverId} {
      allow read: if signedIn()
        && (request.auth.uid == driverId || isAdmin());

      // A driver can register only their own pending driver profile.
      allow create: if signedIn()
        && request.auth.uid == driverId
        && request.resource.data.keys().hasAll([
          'uid', 'firstName', 'lastName', 'fullName', 'phone',
          'email', 'role', 'status', 'approved',
          'hasActiveTask', 'activeTaskId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'firstName', 'lastName', 'fullName', 'phone',
          'email', 'role', 'status', 'approved',
          'hasActiveTask', 'activeTaskId', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == driverId
        && request.resource.data.role == 'driver'
        && request.resource.data.status == 'pending'
        && request.resource.data.approved == false
        && request.resource.data.hasActiveTask == false
        && request.resource.data.activeTaskId == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Driver updates are restricted to schedule settings or
      // coordinated task start/end transactions.
      allow update: if isAdmin()
        ? request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['approved', 'status', 'updatedAt'])
          && request.resource.data.status in ['pending', 'approved', 'rejected']
          && request.resource.data.approved == (request.resource.data.status == 'approved')
          && request.resource.data.updatedAt == request.time
        : signedIn()
          && request.auth.uid == driverId
          && resource.data.approved == true
          && resource.data.status == 'approved'
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'workingDays', 'dutyStartTime', 'dutyEndTime',
                'scheduleConfigured', 'scheduleUpdatedAt',
                'hasActiveTask', 'activeTaskId', 'updatedAt'
              ])
          && request.resource.data.updatedAt == request.time
          && (
            // Saving a duty schedule must not change task state.
            (
              request.resource.data.hasActiveTask == resource.data.hasActiveTask
              && request.resource.data.activeTaskId == resource.data.activeTaskId
              && validSchedule()
            )
            ||
            // Starting a task must create the matching active task
            // in the same Firestore transaction.
            (
              resource.data.hasActiveTask == false
              && resource.data.activeTaskId == null
              && request.resource.data.hasActiveTask == true
              && request.resource.data.activeTaskId is string
              && existsAfter(
                /databases/$(database)/documents/tasks/$(request.resource.data.activeTaskId)
              )
              && getAfter(
                /databases/$(database)/documents/tasks/$(request.resource.data.activeTaskId)
              ).data.driverId == driverId
              && getAfter(
                /databases/$(database)/documents/tasks/$(request.resource.data.activeTaskId)
              ).data.status == 'active'
            )
            ||
            // Ending a task must complete that task and clear
            // the driver's active-task fields in the same transaction.
            (
              resource.data.hasActiveTask == true
              && resource.data.activeTaskId is string
              && request.resource.data.hasActiveTask == false
              && request.resource.data.activeTaskId == null
              && existsAfter(
                /databases/$(database)/documents/tasks/$(resource.data.activeTaskId)
              )
              && getAfter(
                /databases/$(database)/documents/tasks/$(resource.data.activeTaskId)
              ).data.status == 'completed'
              && getAfter(
                /databases/$(database)/documents/tasks/$(resource.data.activeTaskId)
              ).data.driverId == driverId
            )
          );

      allow delete: if false;
    }

    // DRIVER TASKS
    match /tasks/{taskId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.driverId == request.auth.uid);

      // Task creation and driver active-task update must happen together.
      allow create: if signedIn()
        && isApprovedDriver(request.auth.uid)
        && request.resource.data.keys().hasAll([
          'taskId', 'driverId', 'task', 'taskType',
          'classificationSchedule', 'status', 'startedAt',
          'endedAt', 'durationSeconds', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'taskId', 'driverId', 'task', 'taskType',
          'classificationSchedule', 'status', 'startedAt',
          'endedAt', 'durationSeconds', 'createdAt'
        ])
        && request.resource.data.taskId == taskId
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.task is string
        && request.resource.data.task.size() > 0
        && request.resource.data.task.size() <= 500
        && request.resource.data.taskType in ['normal', 'overtime']
        && request.resource.data.classificationSchedule is map
        && request.resource.data.status == 'active'
        && request.resource.data.startedAt == request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.endedAt == null
        && request.resource.data.durationSeconds == null
        && getAfter(
          /databases/$(database)/documents/drivers/$(request.auth.uid)
        ).data.hasActiveTask == true
        && getAfter(
          /databases/$(database)/documents/drivers/$(request.auth.uid)
        ).data.activeTaskId == taskId;

      // A driver can complete their own active task only.
      allow update: if signedIn()
        && resource.data.driverId == request.auth.uid
        && resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'endedAt', 'durationSeconds', 'updatedAt'])
        && request.resource.data.status == 'completed'
        && request.resource.data.endedAt == request.time
        && request.resource.data.durationSeconds is int
        && request.resource.data.durationSeconds >= 0
        && request.resource.data.updatedAt == request.time
        && getAfter(
          /databases/$(database)/documents/drivers/$(request.auth.uid)
        ).data.hasActiveTask == false
        && getAfter(
          /databases/$(database)/documents/drivers/$(request.auth.uid)
        ).data.activeTaskId == null;

      allow delete: if false;
    }

    // LIVE DRIVER LOCATIONS
    match /driverLocations/{driverId} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == driverId);

      allow create, update: if isApprovedDriver(driverId)
        && request.resource.data.keys().hasAll([
          'driverId', 'latitude', 'longitude', 'accuracy',
          'speed', 'heading', 'capturedAt', 'lastUpdatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'driverId', 'latitude', 'longitude', 'accuracy',
          'speed', 'heading', 'capturedAt', 'lastUpdatedAt'
        ])
        && request.resource.data.driverId == driverId
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.accuracy is number
        && request.resource.data.speed is number
        && request.resource.data.heading is number
        && request.resource.data.capturedAt is string
        && request.resource.data.lastUpdatedAt == request.time;

      allow delete: if false;
    }

    // Deny access to every collection not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
